# =============================================================================
# SwiftAdmin 开发环境变量配置示例
# 复制此文件为 .env.local 并修改为你的实际配置
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库配置 (覆盖 application-dev.yml 中的默认值)
# -----------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=swiftadmin
# DB_USERNAME=root
# DB_PASSWORD=your-password

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DATABASE=0

# -----------------------------------------------------------------------------
# JWT 配置 (生产环境必须修改)
# 密钥至少 32 字节 (256 位)
# -----------------------------------------------------------------------------
# JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-bytes-long

# -----------------------------------------------------------------------------
# 文件存储 - 本地存储配置
# -----------------------------------------------------------------------------
# FILE_LOCAL_BASE_PATH=/path/to/uploads

# -----------------------------------------------------------------------------
# 文件存储 - OSS 配置 (阿里云/腾讯云/MinIO)
# -----------------------------------------------------------------------------
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET_NAME=your-bucket-name
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=oss-cn-hangzhou
# OSS_CUSTOM_DOMAIN=https://cdn.your-domain.com

# -----------------------------------------------------------------------------
# 社交登录配置 (可选)
# -----------------------------------------------------------------------------

# 企业微信
# WECOM_CORP_ID=your-corp-id
# WECOM_AGENT_ID=your-agent-id
# WECOM_SECRET=your-secret

# 钉钉
# DINGTALK_APP_KEY=your-app-key
# DINGTALK_APP_SECRET=your-app-secret

# 飞书
# FEISHU_APP_ID=your-app-id
# FEISHU_APP_SECRET=your-app-secret

# 社交登录 Token 加密密钥 (至少 32 字节)
# SOCIAL_TOKEN_SECRET=your-social-token-secret-32bytes

# -----------------------------------------------------------------------------
# 短信服务配置 (可选)
# -----------------------------------------------------------------------------

# 阿里云短信
# SMS_ALIYUN_ACCESS_KEY=your-access-key
# SMS_ALIYUN_SECRET_KEY=your-secret-key
# SMS_ALIYUN_SIGN_NAME=SwiftAdmin
# SMS_ALIYUN_TEMPLATE_CODE=SMS_123456789

# 腾讯云短信
# SMS_TENCENT_SECRET_ID=your-secret-id
# SMS_TENCENT_SECRET_KEY=your-secret-key
# SMS_TENCENT_APP_ID=1400000000
# SMS_TENCENT_TEMPLATE_ID=123456

# -----------------------------------------------------------------------------
# 服务端口配置 (可选)
# -----------------------------------------------------------------------------
# SERVER_PORT=8089
# FRONTEND_PORT=5173