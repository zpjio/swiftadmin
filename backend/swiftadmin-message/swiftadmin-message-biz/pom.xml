<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.swiftadmin</groupId>
        <artifactId>swiftadmin-message</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>swiftadmin-message-biz</artifactId>
    <name>SwiftAdmin :: Message :: Biz</name>

    <dependencies>
        <!-- Common Core -->
        <dependency>
            <groupId>cn.swiftadmin</groupId>
            <artifactId>swiftadmin-common-core</artifactId>
        </dependency>

        <!-- Common Security (for @RequiresPermission, LoginUser) -->
        <dependency>
            <groupId>cn.swiftadmin</groupId>
            <artifactId>swiftadmin-common-security</artifactId>
        </dependency>

        <!-- Common MyBatis (for PageHelper, BeanCopyUtils) -->
        <dependency>
            <groupId>cn.swiftadmin</groupId>
            <artifactId>swiftadmin-common-mybatis</artifactId>
        </dependency>

        <!-- Message API -->
        <dependency>
            <groupId>cn.swiftadmin</groupId>
            <artifactId>swiftadmin-message-api</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI (for @Tag, @Operation annotations) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>

        <!-- MyBatis-Flex -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-processor</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Redis (缓存) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Boot Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 阿里云短信 SDK -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>dysmsapi20170525</artifactId>
        </dependency>

        <!-- 腾讯云短信 SDK -->
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>tencentcloud-sdk-java-sms</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>